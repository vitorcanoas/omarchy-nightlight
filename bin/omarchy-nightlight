#!/bin/bash
# Night light (blue-light filter) with an independent intensity per monitor.
#
# Speaks in percent, on the same scale as the Windows "Night light" slider:
# 0% = 6500K (neutral, no filter) and 100% = 1200K (deep amber).
#
#     Kelvin = 6500 - (53 x percent)
#
# Usage:
#   omarchy-nightlight                 show the state of every output
#   omarchy-nightlight 40              40% on every output
#   omarchy-nightlight DP-2 40         40% on DP-2 only
#   omarchy-nightlight DP-2 +5         raise DP-2 by 5 points
#   omarchy-nightlight brightness 80   software brightness, every output
#   omarchy-nightlight DP-2 brightness 80   software brightness on DP-2 only
#   omarchy-nightlight -5              lower every output by 5 points
#   omarchy-nightlight off             everything neutral
#   omarchy-nightlight DP-2 off        only DP-2 neutral
#   omarchy-nightlight on              restore the saved percentages
#   omarchy-nightlight toggle          off if anything is on, else on
#   omarchy-nightlight reset           neutral white and full brightness, everywhere
#   omarchy-nightlight restore         re-apply the saved file (use at login)
#   omarchy-nightlight --json          machine-readable state, for the bar widget
#
# Why not hyprsunset: it applies one temperature to ALL video outputs at once,
# with no way to pick a monitor. wl-gammarelay-rs is the one that exposes a
# DBus object per output. Both speak the same Wayland gamma-control protocol,
# which allows a single client per output, so they cannot run at the same time:
# keep hyprsunset out of your autostart if you use this.

set -uo pipefail

# Set by the --no-save flag. A slider being dragged applies a new temperature
# many times a second; writing the config on every one of those would hammer the
# disk and, worse, record intensities the user only passed through on the way to
# the one they meant. The widget drags with --no-save and drops the flag on
# release, so exactly one write lands per gesture.
NO_SAVE=0

# Set by --no-start. Installing a plugin must not change the machine: the bar
# widget polls with this flag so merely enabling it never brings the daemon up
# and never takes the Wayland gamma control away from whatever already holds it
# -- hyprsunset, most likely. The daemon starts the first time the user actually
# asks for something.
NO_START=0

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/nightlight.conf"

# The write lock lives in the runtime directory, not beside the config: it is
# session state, it is cleaned up at logout on its own, and it keeps an empty
# lock file out of the user's config folder where it would look like ours to
# keep and theirs to wonder about.
LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-nightlight.lock"

# A second lock, held only while starting the daemon. Separate from the config
# lock on purpose: they protect unrelated things and a shared one would make an
# invocation that is merely waiting for the daemon block someone else's write.
DAEMON_LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-nightlight.daemon.lock"

# The temp file is named from our PID, so this reaches it from anywhere. A
# RETURN trap inside the writing function was not enough: RETURN fires on a
# function returning, and the widget does not wait for that -- its watchdog
# SIGTERMs this process outright, which is exactly the case that used to strand
# `nightlight.conf.tmp.<pid>` in the user's config folder forever.
trap 'rm -f "$CONF.tmp.$$"' EXIT INT TERM
SERVICE="rs.wl-gammarelay"
IFACE="rs.wl.gammarelay"
NEUTRAL=6500       # 0% on the Windows scale
FLOOR=1200         # 100% on the Windows scale
DEFAULT=40         # used when an output has nothing saved yet

# Anything warmer than this counts as "on". Same cut-off Omarchy's own
# `omarchy toggle nightlight` uses, so the two never disagree about the state.
ON_BELOW=6000

die() { printf 'omarchy-nightlight: %s\n' "$*" >&2; exit 1; }
warn() { printf 'omarchy-nightlight: %s\n' "$*" >&2; }

# Set whenever a write did not land. The command still prints what it can, but
# it must not claim success: a script that trusts the exit code has to be able
# to tell "applied" from "the daemon ignored me".
FAILED=0

# The scale is linear in Kelvin, deliberately. The eye perceives colour
# temperature closer to linearly in mireds (a million over Kelvin), so the warm
# half of this slider changes the picture much more than the cool half does --
# 0-50% is a gentle drift, 50-100% is most of the visible effect. That is not a
# bug and it is not worth "fixing": Windows' Night light slider is linear in
# Kelvin over this exact range, and matching what people already have a feel for
# is worth more than a curve that is technically more even. Change it and every
# saved percentage in everyone's config silently means a different colour.
pct_to_kelvin() { local k=$(( NEUTRAL - (53 * $1) )); (( k < FLOOR )) && k=$FLOOR; echo "$k"; }
# Round to the nearest integer instead of truncating, otherwise 40% would read
# back as 39%.
kelvin_to_pct() { echo $(( ( (NEUTRAL - $1) * 2 / 53 + 1 ) / 2 )); }

# Hyprland calls the output "DP-2"; wl-gammarelay-rs's DBus path uses "DP_2".
to_dbus()  { echo "${1//-/_}"; }
to_human() { echo "${1//_/-}"; }

# ---------------------------------------------------------------------------
# The daemon has to be alive: it is what holds the gamma control for each
# output. Normally your autostart brings it up; this is only a safety net for
# someone running the command with it closed.
ensure_daemon() {
  busctl --user status "$SERVICE" >/dev/null 2>&1 && return 0
  (( NO_START )) && return 1

  command -v wl-gammarelay-rs >/dev/null 2>&1 || return 1

  # Serialise from here down. The pgrep below is a check-then-act, and the
  # window is not sub-millisecond: uwsm-app is a shell client that hands the
  # launch to a session daemon over FIFOs, so for the whole round trip no
  # process named wl-gammarelay-rs exists for pgrep to find. Two invocations
  # landing together -- an autostart `restore` and the user's first keybinding
  # -- both passed the check and both asked for a daemon, and the loser could
  # claim neither the bus name nor the gamma control.
  # The braces keep the stderr suppression on the exec alone -- redirections are
  # applied left to right, so `exec 8>... 2>/dev/null` would have let the error
  # through and then made it permanent.
  if { exec 8>"$DAEMON_LOCK"; } 2>/dev/null; then
    # A failed flock is not fatal: worst case we are unserialised, which is
    # where we started. Blocking a keybinding on it would be worse.
    flock -w 10 8 2>/dev/null
  fi

  # Whoever we queued behind may have started it while we waited.
  busctl --user status "$SERVICE" >/dev/null 2>&1 && { exec 8>&- 2>/dev/null; return 0; }

  # `wl-gammarelay-rs?` with the trailing s optional, because the name is 16
  # characters and the kernel truncates comm to 15: `pgrep -x wl-gammarelay-rs`
  # matches NOTHING, ever. Every guard built on it was dead code -- this branch
  # never ran, so a second daemon was spawned on top of a blocked one, and
  # daemon_problem could never reach the message it has for that case.
  # A running daemon that has not claimed the bus name may be blocked -- almost
  # always hyprsunset holding the outputs -- or may simply be 80ms old. This
  # used to return 1 immediately, so a second keypress during startup died with
  # "something else may hold the gamma control" on a machine where nothing was
  # wrong. Telling the two apart costs one bounded wait.
  local rc
  if pgrep -x 'wl-gammarelay-rs?' >/dev/null 2>&1; then
    # Only wait when the cause could be youth. A daemon blocked by hyprsunset is
    # not going to claim the bus in four seconds or in four hours, and paying
    # that wait on every keypress of a permanently conflicted machine helps
    # nobody -- daemon_problem already names hyprsunset in that case.
    if pgrep -x hyprsunset >/dev/null 2>&1; then
      rc=1
    else
      wait_for_bus
      rc=$?
    fi
    exec 8>&- 2>/dev/null
    return $rc
  fi

  # Prefer uwsm-app so the daemon lands in the compositor's own systemd scope
  # and dies with the session; fall back to a bare setsid where uwsm is absent.
  # 8>&- is load-bearing. Without it the daemon inherits the open lock file
  # description and holds the exclusive lock for its entire life, so the NEXT
  # invocation blocks on the daemon -- not on us -- for the full flock timeout,
  # then proceeds unserialised anyway. That turned a millisecond race into a
  # ten-second stall that still did not serialise.
  if command -v uwsm-app >/dev/null 2>&1; then
    setsid uwsm-app -- wl-gammarelay-rs >/dev/null 2>&1 8>&- &
  else
    setsid wl-gammarelay-rs >/dev/null 2>&1 8>&- &
  fi

  wait_for_bus
  rc=$?
  exec 8>&- 2>/dev/null
  return $rc
}

# Bounded backoff waiting for the bus name: a daemon that is going to come up
# does so in well under a second, and one that is not should not cost three more
# seconds of a blocked terminal on every call. Six steps, ~4.1s total.
#
# Milliseconds as integers, not an awk float. awk's `print` formats according to
# LC_NUMERIC, so under a comma-decimal locale the delay came out as "0,18",
# `sleep` rejected it, and -- with no `set -e` and the status discarded -- the
# loop spun through all six iterations with no delay at all, reporting that a
# daemon which needed 300ms "would not start".
wait_for_bus() {
  local ms=100
  for _ in {1..6}; do
    LC_ALL=C sleep "$(( ms / 1000 )).$(printf '%03d' $(( ms % 1000 )))" || return 1
    busctl --user status "$SERVICE" >/dev/null 2>&1 && return 0
    ms=$(( ms * 18 / 10 ))
  done
  return 1
}

# One line, no quotes and no newlines: it goes into the JSON the widget reads.
daemon_problem() {
  if ! command -v wl-gammarelay-rs >/dev/null 2>&1; then
    printf 'wl-gammarelay-rs is not installed. Install it with: yay -S wl-gammarelay-rs'
  elif pgrep -x hyprsunset >/dev/null 2>&1; then
    printf 'hyprsunset is holding the Wayland gamma control, so wl-gammarelay-rs cannot start. Stop it: pkill hyprsunset'
  elif pgrep -x 'wl-gammarelay-rs?' >/dev/null 2>&1; then
    printf 'wl-gammarelay-rs is running but has not claimed its bus name. Something else may hold the gamma control.'
  elif (( NO_START )); then
    printf 'wl-gammarelay-rs is not running.'
  else
    printf 'wl-gammarelay-rs would not start.'
  fi
}

# The outputs that exist right now, in human names (DP-2, HDMI-A-1...).
# Resolved once per run into ALL_OUTPUTS below: this used to re-shell busctl on
# every call, which on a slider drag meant hundreds of forks a second.
outputs_uncached() {
  busctl --user tree "$SERVICE" 2>/dev/null |
    grep -oE '/outputs/[A-Za-z0-9_]+' | sed 's|/outputs/||' | while read -r o; do
      to_human "$o"
    done
}

kelvin_of() {
  get_prop "$1" Temperature | grep -oE '[0-9]+' | head -n1
}

# One writer for every per-output property wl-gammarelay-rs exposes. Generic
# because the daemon offers Temperature, Brightness, Gamma and Inverted on the
# same object with the same call shape; only the first two are wired up here,
# but adding another is a line rather than a new function.
set_prop() {
  busctl --user set-property "$SERVICE" "/outputs/$(to_dbus "$1")" "$IFACE" "$2" "$3" "$4" >/dev/null 2>&1
}

get_prop() {
  busctl --user get-property "$SERVICE" "/outputs/$(to_dbus "$1")" "$IFACE" "$2" 2>/dev/null
}

set_kelvin() { set_prop "$1" Temperature q "$2"; }

# Brightness is a double from 0.1 to 1.0; this script speaks whole percent.
# The floor is the daemon's, not ours: 0 would be a black screen with no way
# back except the CLI.
BRIGHT_MIN=10

set_brightness() {
  local pct=$1
  (( pct < BRIGHT_MIN )) && pct=$BRIGHT_MIN
  (( pct > 100 )) && pct=100
  # Returns busctl's own status, so every caller can tell a delivered write
  # from a refused one.
  set_prop "$2" Brightness d "$(printf '%d.%02d' $((pct / 100)) $((pct % 100)))"
}

brightness_of() {
  local raw; raw=$(get_prop "$1" Brightness)
  [[ -z $raw ]] && return 1
  # `busctl` prints `d 0.8`; turn that into whole percent without needing bc.
  awk '{ printf "%d", ($NF * 100) + 0.5 }' <<<"$raw"
}

# ---------------------------------------------------------------------------
# The saved file is the memory between reboots: one `output=percent` line each.
# It stores the CHOSEN percentage, not what is on screen right now — which is
# why `off` erases nothing and `on` can bring everything back.

# What is literally written for this output, or nothing when it was never
# chosen. Kept separate from `saved_pct` because "nothing is written" and
# "zero is written" are different things: `restore` at login may only touch an
# output the user has actually chosen at some point.
pct_in_file() {
  [[ -f $CONF ]] || return 1
  local p; p=$(grep -oP "^\s*$1\s*=\s*\K[0-9]+" "$CONF" | tail -n1)
  [[ -n $p ]] && echo "$p"
}

# Brightness is stored under a second key per output, `DP-2.brightness=80`, so
# an old config with only temperature lines still reads correctly and a screen
# that never had its brightness touched simply has no line.
brightness_in_file() {
  [[ -f $CONF ]] || return 1
  local b; b=$(grep -oP "^\s*$1\.brightness\s*=\s*\K[0-9]+" "$CONF" | tail -n1)
  [[ -n $b ]] && echo "$b"
}

saved_brightness() {
  brightness_in_file "$1" || echo 100
}

# The percentage `on` returns to. Falls back to the default when the output has
# no choice recorded yet.
saved_pct() {
  pct_in_file "$1" || echo "$DEFAULT"
}

save_pct() { save_key "$1" "$2"; }
save_brightness_pct() { save_key "$1.brightness" "$2"; }

# Serialised with flock because the write is read-modify-write, and the two
# writers here are genuinely concurrent: a `+5` keybinding can fire while a
# slider is being released. Without the lock both read the old file and the
# loser's key vanishes from it. The mv below is already atomic; this is what
# makes the read-then-write around it atomic too.
save_key() {
  local out=$1 pct=$2
  mkdir -p "$(dirname "$CONF")"
  # -w rather than a bare flock: a writer wedged while holding the lock used to
  # block every later invocation forever. The widget has a 15s watchdog for that
  # (see Panel.qml), but a keybinding has nothing and simply hangs. Five seconds
  # is far longer than an honest write takes, and it ends.
  ( flock -w 5 9 || exit 1
    trap 'rm -f "$CONF.tmp.$$"' EXIT
    save_key_locked "$out" "$pct"
  ) 9>"$LOCK"
}

save_key_locked() {
  local out=$1 pct=$2
  if [[ ! -f $CONF ]]; then
    cat > "$CONF" <<EOF || return 1
# Night light: per-output intensity, in percent.
#
# Same scale as the Windows slider: 0 = neutral, 100 = maximum.
# Kelvin = 6500 - (53 x percent).
#
# Written by \`omarchy-nightlight\`. You can edit it by hand, but the easy way
# is \`omarchy-nightlight DP-2 40\`, which also applies it right away.
#
# The output name is the same one \`hyprctl monitors\` prints.
EOF
  fi

  # Write a whole new file and rename it over the old one. rename(2) is atomic:
  # a reader sees the old file or the new one, never half of either.
  #
  # But atomically promoting a BAD file is just a reliable way to lose data, and
  # that is what used to happen. None of the commands building the temp file had
  # their exit status checked, so an unreadable config (mode 000, or a full
  # disk) produced a one-line temp that `mv` then promoted over the real thing --
  # exit 0, "success" printed, every other screen's setting gone. `mv` only
  # needs write permission on the directory, so it had no trouble doing it.
  local tmp="$CONF.tmp.$$"

  # awk rather than sed, for three reasons the sed version got wrong:
  #
  #  - It rewrites the VALUE and keeps anything the user wrote after it. A
  #    whole-line replace ate trailing comments, and the header above invites
  #    hand-editing; worse, the size guard below then read that shrink as data
  #    loss and refused every future save, permanently.
  #  - It replaces the value whatever the value looks like. The old pair
  #    disagreed with itself -- grep decided the key existed on `key\s*=`, sed
  #    only rewrote a value matching `[0-9]+` -- so `DP-2=` or `DP-2=abc` made
  #    sed copy the file verbatim and exit 0. save_key reported success having
  #    written nothing, and the setting silently vanished at the next login.
  #  - It appends through a record, so a config with no trailing newline gets
  #    one instead of producing `DP-2=40DP-9=30`, which no reader could parse.
  #
  # Every matching line is rewritten, not just the first: leaving a stale
  # duplicate behind would make the read-back below disagree with itself.
  awk -v key="$out" -v val="$pct" '
    BEGIN { pat = "^[ \t]*" key "[ \t]*=" ; found = 0 }
    {
      if ($0 ~ pat) {
        found = 1
        match($0, pat)
        head = substr($0, 1, RLENGTH)
        rest = substr($0, RLENGTH + 1)
        hash = index(rest, "#")
        if (hash > 0) print head val " " substr(rest, hash)
        else print head val
        next
      }
      print
    }
    END { if (!found) print key "=" val }
  ' "$CONF" >"$tmp" 2>/dev/null || return 1

  # A temp file smaller than the original means content was lost on the way,
  # whatever the exit codes said. Refuse rather than promote it.
  local old_size new_size
  old_size=$(wc -c <"$CONF" 2>/dev/null) || return 1
  new_size=$(wc -c <"$tmp" 2>/dev/null) || return 1
  if (( new_size < old_size - 8 )); then
    return 1
  fi

  # Read the value back out of the temp before promoting it. If what we are
  # about to install does not say what we were asked to write, nothing else in
  # here gets to call this a success.
  #
  # awk again, not `grep -oP`: the read path already degrades where grep is
  # built without PCRE, and asserting with -P here would have turned that
  # degradation into a hard failure of every save on such a machine.
  local written
  written=$(awk -v key="$out" '
    BEGIN { pat = "^[ \t]*" key "[ \t]*=[ \t]*" ; v = "" }
    $0 ~ pat { line = $0; sub(pat, "", line); sub(/[^0-9].*$/, "", line); v = line }
    END { print v }
  ' "$tmp" 2>/dev/null)
  [[ $written == "$pct" ]] || return 1

  mv -f "$tmp" "$CONF" || return 1
}

# ---------------------------------------------------------------------------
# Neutralise one output and REPORT it if the write did not land. `off`,
# `toggle`, `reset` and `restore` used to call set_kelvin bare and discard its
# status, so with the daemon dead or an output unplugged they printed their OSD,
# printed a state table built from reads that had failed too, and exited 0 with
# the screen still amber. `reset` is the documented way to un-tint your screens
# before deleting the plugin -- it lying is the worst version of this bug.
go_neutral() {
  set_kelvin "$1" "$NEUTRAL" || {
    warn "could not neutralise $1"
    FAILED=1
    return 1
  }
}

is_on() {
  local k; k=$(kelvin_of "$1")
  [[ -n $k ]] && (( k < ON_BELOW ))
}

# Apply without touching the file. Every momentary gesture uses this: a switch,
# `on`, `toggle`. Turning a filter on and off is not a statement about what
# intensity you want, so it must never rewrite what you chose.
light_up() {
  local out=$1 pct=$2
  (( pct < 0 )) && pct=0
  (( pct > 100 )) && pct=100
  set_kelvin "$out" "$(pct_to_kelvin "$pct")" || {
    warn "could not set the temperature on $out"
    FAILED=1
    return 1
  }
}

# The percentage a momentary "on" should use for one output. A screen saved at 0
# is excused from the filter on purpose; a global command skips it entirely, but
# when it is named explicitly -- someone clicked its switch -- the gesture still
# has to do something visible, so it lights up at the default. It is NOT saved,
# so the screen goes straight back to being excused when it is switched off and
# `restore` still leaves it neutral at the next login.
on_pct() {
  local p; p=$(saved_pct "$1")
  (( p > 0 )) && echo "$p" || echo "$DEFAULT"
}

# Apply AND save. Reached only from an explicit percentage -- a slider drag, a
# `DP-2 40`, a `+5`. That is the one gesture that means "this is the intensity I
# want for this screen", so it is the one gesture allowed to rewrite the file.
apply_to() {
  local out=$1 pct=$2 k actual
  (( pct < 0 )) && pct=0
  (( pct > 100 )) && pct=100
  k=$(pct_to_kelvin "$pct")

  set_kelvin "$out" "$k" || {
    warn "could not set the temperature on $out"
    FAILED=1
    return 1
  }

  (( NO_SAVE )) && return 0

  # Read it back before recording it. busctl exits 0 for a call that was
  # delivered, which is not the same as a call that took effect -- a monitor
  # unplugged between listing and writing takes the write and drops it. Without
  # this the command printed the old value, saved the new one, and changed
  # nothing on screen, all with exit 0. Only on a committing write: a drag
  # passes --no-save and skips the extra round trip.
  actual=$(kelvin_of "$out")
  if [[ -n $actual && $actual != "$k" ]]; then
    warn "$out did not take the new temperature; leaving the saved value alone"
    FAILED=1
    return 1
  fi

  # Zero is saved too: "this screen stays neutral" is a choice, and it has to
  # survive `on` and the next boot. That is the whole point of per-output
  # control -- a portrait monitor used for dark-mode terminals is usually worse
  # with a warm filter on it.
  #
  # Nothing else in this script writes the file. `off`, `on` and `toggle` all go
  # through set_kelvin or light_up, so a momentary gesture can never erase a
  # screen's saved intensity -- or, worse, promote an excused screen to a real
  # percentage and light it up at the next login.
  save_pct "$out" "$pct" || {
    warn "could not write $CONF; $out is set but the change will not survive a reboot"
    FAILED=1
    return 1
  }
}

# Software brightness, applied through the same gamma ramp as the temperature.
# Deliberately NOT the same thing as Omarchy's own brightness control, which
# drives the monitor's backlight over DDC/CI and does nothing on a display that
# does not answer DDC. This works on any output the compositor can gamma-adjust,
# which is all of them.
apply_brightness() {
  local out=$1 pct=$2
  (( pct < BRIGHT_MIN )) && pct=$BRIGHT_MIN
  (( pct > 100 )) && pct=100
  set_brightness "$pct" "$out" || {
    warn "could not set the brightness on $out"
    FAILED=1
    return 1
  }
  (( NO_SAVE )) && return 0
  save_brightness_pct "$out" "$pct" || {
    warn "could not write $CONF; $out is set but the change will not survive a reboot"
    FAILED=1
    return 1
  }
}

# Turn "+5", "-5" or "40" into a final percentage for one output, already
# clamped to 0-100.
#
# Two things this has to get right, both of which used to be wrong:
#
# The base for a relative step is where the screen WOULD be, not what it is
# showing. After `off` the screen reads 6500K, so stepping from the live value
# meant `off` then `+5` recorded 5 -- destroying the intensity the file was
# holding for you, which is the one promise `off` makes.
#
# And the clamp belongs here, before anything is saved. It used to happen inside
# apply_to, which then wrote the clamped number: a global `-5` that ran past
# zero recorded 0, and 0 is exactly the mark that means "excuse this screen from
# the filter forever". Eight taps of a keybinding could retire a monitor
# silently, and nothing but an explicit percentage brought it back.
resolve_pct() {
  local out=$1 want=$2 now result
  case $want in
    +*|-*)
      if is_on "$out"; then
        now=$(kelvin_of "$out")
        now=$([[ -n $now ]] && kelvin_to_pct "$now" || echo 0)
      else
        now=$(saved_pct "$out")
      fi
      result=$(( now + want )) ;;
    *) result=$want ;;
  esac
  (( result < 0 )) && result=0
  (( result > 100 )) && result=100
  echo "$result"
}

# hyprsunset and wl-gammarelay-rs both claim the Wayland gamma-control protocol,
# which allows one client per output. When both run, whichever lost the race
# silently does nothing and the screen simply ignores this tool -- with no error
# anywhere to explain it. Report it on every read, not only when the daemon
# fails to start, because the confusing case is the one where it started fine.
conflict_warning() {
  pgrep -x hyprsunset >/dev/null 2>&1 || return 0
  printf 'hyprsunset is running and fighting wl-gammarelay-rs for the same outputs. Stop it: pkill hyprsunset'
}

# Omarchy's shared on-screen display, so a keybinding gets visual feedback.
# There is no night-light icon in the Omarchy OSD; "brightness" is the closest.
osd() {
  command -v omarchy >/dev/null 2>&1 || return 0
  omarchy osd -i brightness -p "$1" -m "$2" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
show() {
  local o k b warning
  warning=$(conflict_warning)
  [[ -n $warning ]] && printf 'warning: %s\n\n' "$warning" >&2
  for o in $(outputs); do
    k=$(kelvin_of "$o")
    b=$(brightness_of "$o") || b=100
    if is_on "$o"; then
      printf '%-12s %3d%%  (%dK)   brightness %d%%\n' "$o" "$(kelvin_to_pct "$k")" "$k" "$b"
    else
      printf '%-12s  off   (saved at %d%%)   brightness %d%%\n' "$o" "$(saved_pct "$o")" "$b"
    fi
  done
}

# The contract the bar widget reads. Keep the key names stable.
json() {
  local o k b pct on configured first=1
  printf '{"warning":"%s","daemon":true,"outputs":[' "$(conflict_warning)"
  for o in $(outputs); do
    # One read of the temperature, reused for both the value and the on/off
    # decision. Calling is_on here meant a second busctl round trip per screen.
    k=$(kelvin_of "$o"); [[ -z $k ]] && continue
    if (( k < ON_BELOW )); then on=true; pct=$(kelvin_to_pct "$k")
    else on=false; pct=0; fi
    (( first )) || printf ','
    first=0
    b=$(brightness_of "$o") || b=100
    # `configured` separates "never chosen" from "chosen as 40", which `saved`
    # alone cannot express because it falls back to the default.
    if pct_in_file "$o" >/dev/null; then configured=true; else configured=false; fi
    printf '{"name":"%s","percent":%d,"kelvin":%d,"on":%s,"saved":%d,"configured":%s,"brightness":%d}' \
      "$o" "$pct" "$k" "$on" "$(saved_pct "$o")" "$configured" "$b"
  done
  printf ']}\n'
}

# ---------------------------------------------------------------------------
ARGS=()
for arg in "$@"; do
  case $arg in
    --no-save)  NO_SAVE=1 ;;
    --no-start) NO_START=1 ;;
    *)          ARGS+=("$arg") ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

case "${1:-}" in
  # Print the header comment and stop at the first line that is not one, rather
  # than a hardcoded range that leaked `set -uo pipefail` and half of the next
  # comment every time the header changed length.
  -h|--help|help) sed -n '2,${/^#/!q;p;}' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

# A read must never be the thing that starts the daemon, and a machine without
# it must still get an answer it can act on rather than a failure.
if ! ensure_daemon; then
  case "${1:-}" in
    --json)
      printf '{"warning":"%s","daemon":false,"outputs":[]}\n' "$(daemon_problem)"
      exit 0 ;;
    "")
      printf '%s\n' "$(daemon_problem)"
      exit 0 ;;
    *)
      die "$(daemon_problem)" ;;
  esac
fi

# Listed once, then served from memory for the rest of the run.
mapfile -t ALL_OUTPUTS < <(outputs_uncached)
outputs() { (( ${#ALL_OUTPUTS[@]} )) && printf '%s\n' "${ALL_OUTPUTS[@]}"; return 0; }

# If the first argument names an output, the command applies to it alone.
TARGETS=(); ACTION=""; NAMED_OUTPUT=0
# ARG is the word after the action, for the verbs that take one (`brightness
# 80`). It has to be read here because naming an output shifts every position
# by one, and reading $2 from inside a case branch would silently be the action
# itself for `DP-2 brightness 80`.
# -F because an output name is data, not a pattern: without it an argument of
# `.*` would match some real output and quietly act on the wrong screen.
if [[ -n ${1:-} ]] && outputs | grep -qxF -- "$1"; then
  TARGETS=("$1"); ACTION="${2:-}"; ARG="${3:-}"; NAMED_OUTPUT=1
else
  mapfile -t TARGETS < <(outputs)
  ACTION="${1:-}"; ARG="${2:-}"
fi

# An output saved at 0% is deliberately neutral. A global command (no output
# name) must not light it up: without this, a "+5 everywhere" keybinding would
# put 5% on the screen that is supposed to stay clean. Naming the output
# explicitly still works — that is how you change your mind.
excused() {
  (( NAMED_OUTPUT )) && return 1
  local p; p=$(pct_in_file "$1") || return 1
  (( p == 0 ))
}

# No outputs is the shape the conflict takes: the daemon answers on the bus but
# has bound nothing, because another client holds every output's gamma control.
# Saying only "no outputs found" here is what made that case unexplainable.
if (( ${#TARGETS[@]} == 0 )); then
  conflict=$(conflict_warning)
  reason="no outputs found. ${conflict:-wl-gammarelay-rs has not bound any output; something else may hold the gamma control.}"
  # A caller asking for JSON gets JSON, including when the answer is "none".
  # Printing prose on this path made the widget fall back to "unusable" and keep
  # stale values, instead of saying there were no screens.
  if [[ ${ACTION:-} == --json ]]; then
    printf '{"warning":"%s","daemon":true,"outputs":[]}\n' "$reason"
    exit 0
  fi
  die "$reason"
fi

case "$ACTION" in
  "")
    if [[ ${#TARGETS[@]} -eq 1 && -n ${1:-} ]]; then
      k=$(kelvin_of "${TARGETS[0]}")
      is_on "${TARGETS[0]}" \
        && printf '%s on at %d%% (%dK)\n' "${TARGETS[0]}" "$(kelvin_to_pct "$k")" "$k" \
        || printf '%s off (saved at %d%%)\n' "${TARGETS[0]}" "$(saved_pct "${TARGETS[0]}")"
    else
      show
    fi ;;

  --json) json ;;

  restore)
    # Meant for login. Re-applies the file without touching outputs that are
    # saved at 0, which must come up neutral. Only outputs with a recorded
    # choice are touched at all, so on a machine that never configured night
    # light nothing is applied and the autostart line stays harmless — that is
    # what lets you version one autostart across every machine.
    for o in "${TARGETS[@]}"; do
      b=$(brightness_in_file "$o") && { set_brightness "$b" "$o" || { warn "could not set brightness on $o"; FAILED=1; }; }
      p=$(pct_in_file "$o") || continue
      # A screen written as 0 is meant to be neutral, so say so rather than
      # leaving whatever ramp happened to be loaded. At login that is already
      # true and this is a no-op; run by hand after an `on` it is the difference
      # between "restored the file" and "restored most of the file".
      if (( p > 0 )); then
        set_kelvin "$o" "$(pct_to_kelvin "$p")" || { warn "could not set the temperature on $o"; FAILED=1; }
      else
        go_neutral "$o"
      fi
    done ;;

  on)
    osd_pct=""
    for o in "${TARGETS[@]}"; do
      excused "$o" && continue
      [[ -z $osd_pct ]] && osd_pct=$(on_pct "$o")
      light_up "$o" "$(on_pct "$o")"
    done
    osd "${osd_pct:-0}" "Night light"
    show ;;

  off)
    for o in "${TARGETS[@]}"; do go_neutral "$o"; done
    osd 0 "Night light off"
    show ;;

  toggle)
    # If any output in the set is on, the gesture is "turn everything off" —
    # otherwise one forgotten monitor would invert the meaning of the shortcut.
    any=0
    for o in "${TARGETS[@]}"; do is_on "$o" && any=1; done
    if (( any )); then
      for o in "${TARGETS[@]}"; do go_neutral "$o"; done
      osd 0 "Night light off"
    else
      osd_pct=""
      for o in "${TARGETS[@]}"; do
        excused "$o" && continue
        [[ -z $osd_pct ]] && osd_pct=$(on_pct "$o")
        light_up "$o" "$(on_pct "$o")"
      done
      osd "${osd_pct:-0}" "Night light"
    fi
    show ;;

  reset)
    # Everything back to how the screen looks with no plugin at all: neutral
    # white and full brightness. This is the way out, and it matters most for
    # someone who dimmed a screen and then removed the plugin -- the CLI goes
    # with the folder, and the daemon keeps applying the last ramp it was given.
    # Nothing is saved, so the chosen intensities survive for a later `on`.
    for o in "${TARGETS[@]}"; do
      go_neutral "$o"
      set_brightness 100 "$o" || { warn "could not restore brightness on $o"; FAILED=1; }
    done
    osd 0 "Night light reset"
    show ;;

  brightness)
    # `omarchy-nightlight brightness 80` on every output, or
    # `omarchy-nightlight DP-2 brightness 80` on one. Unlike the filter, this is
    # never skipped for an "excused" screen: being excused is a statement about
    # colour temperature, not about how bright you want the panel.
    [[ $ARG =~ ^[0-9]+$ ]] || die "brightness takes a percentage from $BRIGHT_MIN to 100"
    # Say no rather than silently clamping: the message promised a range, and a
    # `brightness 0` that quietly became 10 taught the caller the wrong thing.
    (( ARG >= BRIGHT_MIN && ARG <= 100 )) || die "brightness takes a percentage from $BRIGHT_MIN to 100, got $ARG"
    for o in "${TARGETS[@]}"; do apply_brightness "$o" "$ARG"; done
    show ;;

  +[0-9]*|-[0-9]*|[0-9]*)
    [[ $ACTION =~ ^[+-]?[0-9]+$ ]] || die "invalid percentage: $ACTION"
    relative=0
    [[ $ACTION == [+-]* ]] && relative=1
    osd_pct=""
    for o in "${TARGETS[@]}"; do
      excused "$o" && continue
      target=$(resolve_pct "$o" "$ACTION")
      [[ -z $osd_pct ]] && osd_pct=$target
      if (( relative && target == 0 )); then
        # A decrement that runs out of room means "off", not "retire this
        # screen". Apply neutral and leave the saved intensity where it is, so
        # the next `on` or `+5` still knows what you had chosen.
        set_kelvin "$o" "$NEUTRAL" || { warn "could not reach $o"; FAILED=1; }
      else
        apply_to "$o" "$target"
      fi
    done
    # The OSD shows the first screen the command actually touched. Reading
    # TARGETS[0] blindly reported a number for a screen that had been skipped.
    osd "${osd_pct:-0}" "Night light"
    show ;;

  *) die "unknown command \"$ACTION\". See 'omarchy-nightlight --help'" ;;
esac

# A command that printed a result but failed to apply or record part of it must
# not look like a success to whatever called it.
exit "$FAILED"
