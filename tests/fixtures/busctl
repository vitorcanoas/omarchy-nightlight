#!/usr/bin/env bash

case "${2:-}" in
  status)
    if [[ ${FAKE_BUSCTL_HANG:-0} == 1 ]]; then
      printf '%s\n' "$BASHPID" >"$FAKE_BUSCTL_HANG_PID"
      sleep 30
    fi
    [[ ${FAKE_BUSCTL_NO_DAEMON:-0} == 1 ]] && exit 1
    exit 0
    ;;
  tree)
    if [[ ${FAKE_BUSCTL_HUGE:-0} == 1 ]]; then
      for i in $(seq 1 4096); do
        printf '/rs/wl/gammarelay/outputs/DP_%s\n' "$i"
      done
    else
      printf '/rs/wl/gammarelay/outputs/DP_2\n'
    fi
    ;;
  get-property)
    case "${6:-}" in
      Temperature) printf 'q 6500\n' ;;
      Brightness) printf 'd 1.0\n' ;;
      *) exit 1 ;;
    esac
    ;;
  set-property)
    exit 0
    ;;
  *)
    exit 1
    ;;
esac
